{
	"name": "insis-mcp",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*",
		"mcp"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"type-check": "npm run type-check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,mjs,json}\"",
		"format:check": "prettier --check \"**/*.{ts,mjs,json}\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
