# /etc/insis-mcp/monitoring.env (root:deploy 640). Secrets: openssl rand -hex 24

# Grafana is served at https://<GRAFANA_HOST>/grafana
GRAFANA_HOST=mcp.insis.cz
GRAFANA_ADMIN_PASSWORD=

# Password of the Postgres role alloy_monitor (pg_monitor rights)
PG_MONITOR_PASSWORD=

# Discord webhooks: alerts (prod and host), alerts for dev, weekly usage report
DISCORD_ALERTS_WEBHOOK=
DISCORD_ALERTS_DEV_WEBHOOK=
DISCORD_REPORTS_WEBHOOK=
