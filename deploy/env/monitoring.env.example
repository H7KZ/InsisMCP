# /etc/insis-mcp/monitoring.env (root:root 600). Secrets: openssl rand -hex 24

# Grafana is not public: ssh -L 3000:localhost:3000 <you>@bpmcp.vse.cz, then open http://localhost:3000
GRAFANA_ADMIN_PASSWORD=

# Password of the Postgres role alloy_monitor (pg_monitor rights)
PG_MONITOR_PASSWORD=

# Discord webhooks: alerts (prod and host), alerts for dev, weekly usage report
DISCORD_ALERTS_WEBHOOK=
DISCORD_ALERTS_DEV_WEBHOOK=
DISCORD_REPORTS_WEBHOOK=
