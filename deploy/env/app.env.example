# /etc/insis-mcp/prod.env or /etc/insis-mcp/dev.env (root:deploy 640).
# Passwords: openssl rand -hex 24 (hex only: they are embedded in connection URLs)

APP_ENV=prod
# mcp.insis.cz (prod) or bpmcp.insis.cz (dev)
PUBLIC_HOST=mcp.insis.cz

# Database and roles of this environment
PG_DATABASE=insis_prod
ETL_DB_USER=etl_prod
ETL_DB_PASSWORD=
MCP_DB_USER=mcp_prod
MCP_DB_PASSWORD=

# isis-db2, passed to the ETL container only (TODO: connection details from the advisor, see TODO.md)
ORACLE_USER=
ORACLE_PASSWORD=
# host:port/service_name
ORACLE_CONNECT_STRING=

# Browser origins allowed to call /mcp, comma-separated (non-browser clients send no Origin)
ALLOWED_ORIGINS=

# Traefik rate limit per client IP: requests/s and burst (TODO: tune on real traffic)
RATE_LIMIT_AVERAGE=20
RATE_LIMIT_BURST=40

# Discord webhooks: ETL failures (#alerts for prod, #alerts-dev for dev), deploy results (#deploys)
DISCORD_ALERTS_WEBHOOK=
DISCORD_DEPLOYS_WEBHOOK=
